# Don't store changes on autogenerated files
extend-diff-ignore = "((^|/)(\.eggs|\.github|\.claude|CLAUDE\.md|doc/html|doc/_build/|package-lock.json|.npm|build/|node_modules/|css/|nav.egg-info|.*\.egg|\.cache|\.pip-cache))|\.pyc$"
# Exclude build cache directories from source package
tar-ignore = "debian/.cache"
tar-ignore = "debian/.pip-cache"
