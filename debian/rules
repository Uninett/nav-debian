#!/usr/bin/make -f
package     := nav
DEBIAN_ROOT := $(CURDIR)/debian/$(package)

# Derive a PEP 440-valid version for setuptools_scm from the Debian upstream
# version. Master snapshot builds carry a `git describe` changelog version like
# 5.19.0-4-gb1685b2e2 (kept in that form because gbp resolves the upstream
# version as a treeish via upstream-tag). That is not valid PEP 440, so
# translate the -N-gSHA suffix into a post-release + local segment
# (-> 5.19.0.post4+gb1685b2e2), preserving the commit distance and hash rather
# than masquerading as the plain release. A leading +local (e.g. +ds) is dropped.
include /usr/share/dpkg/pkg-info.mk
VERSION_UPSTREAM = $(shell echo '$(DEB_VERSION_UPSTREAM)' | sed -e 's/\+[^+]*//' -e 's/-\([0-9]\{1,\}\)-\(g[0-9a-f]\{1,\}\)/.post\1+\2/')
export SETUPTOOLS_SCM_PRETEND_VERSION = $(VERSION_UPSTREAM)

%:
	dh $@ --with quilt --with systemd --with python-virtualenv

.PHONY: override_dh_auto_install override_dh_auto_test

override_dh_virtualenv:
	npm install
	npm run build:sass

	# docs deps live in the 'docs' PEP 735 dependency-group (build-time only),
	# so install them with uv's --group; ldap and gammu are real extras.
	dh_virtualenv --pip-tool /usr/local/bin/uv-pip --extras ldap,gammu --requirements /dev/null --extra-pip-arg="--group=docs" --extra-pip-arg="-cconstraints.txt" --extra-pip-arg "setuptools>=50.2.0"

	# Replace Debian's patched pip (which requires system python3-pip) with upstream pip
	/usr/local/bin/uv pip install --reinstall --python $(DEBIAN_ROOT)/opt/venvs/nav/bin/python pip
	# Fix shebangs: uv writes the build-time path, but dh-virtualenv expects /opt/venvs/nav/...
	sed -i '1s|#!$(DEBIAN_ROOT)/opt/venvs/nav/|#!/opt/venvs/nav/|' $(DEBIAN_ROOT)/opt/venvs/nav/bin/pip*

	$(DEBIAN_ROOT)/opt/venvs/nav/bin/python $(DEBIAN_ROOT)/opt/venvs/nav/bin/sphinx-build doc/ doc/_build/html
	dh_installdocs doc/_build/html
	dh_installdocs NOTES.rst
	dh_installchangelogs CHANGELOG.md HISTORY

	# copy initial set of config files
	mkdir $(DEBIAN_ROOT)/etc/nav && cp -a $(CURDIR)/python/nav/etc/* $(DEBIAN_ROOT)/etc/nav/

	# apache2 sites-available-file and our own Debian-specific apache config
	install -m644 debian/nav.apache2-site \
	  $(DEBIAN_ROOT)/etc/apache2/sites-available/nav-default.conf
	install -m644 debian/apache.conf \
	  $(DEBIAN_ROOT)/etc/nav/apache/apache.conf

	# Re-enable global site packages for runtime. We don't want to build
	# the virtualenv that way, however, since dh-virtualenv/pip will
	# consider many of the baser requirements to already be satisfied by
	# the build system.
	sed -ie 's/^include-system-site-packages.*/include-system-site-packages = true/' $(DEBIAN_ROOT)/opt/venvs/nav/pyvenv.cfg

override_dh_strip:
	dh_strip --exclude=/site-packages/

override_dh_shlibdeps:
	dh_shlibdeps --exclude=/site-packages/

override_dh_strip_nondeterminism:

override_dh_auto_test:
